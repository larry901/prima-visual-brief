# Vercel Postgres (required) — copy from Vercel dashboard → Storage → your DB → .env.local tab
POSTGRES_URL=postgres://user:password@host/db?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://user:password@host/db?sslmode=require

# Email (required) — Resend API key, sends from clients@primavisual.io
EMAIL_API_KEY=your_resend_api_key

# Dashboard auth. Session cookies are signed with a key derived from this password,
# so rotating it logs every staff session out. No separate session secret is required.
DASHBOARD_PASSWORD=your_secure_password

# Client portal magic links. Optional. When unset, links use the request host.
# Set this in production so email links always point at the public site.
APP_URL=https://brief.primavisual.io

# Bearer token for POST /api/ingest/acuity. Generate a long random string.
# The endpoint stays closed until this is set. Do not commit the real value.
ACUITY_INGEST_TOKEN=replace-with-a-long-random-string

# Set to true only on a preview or local machine to load fictional example.com
# clients and to show their magic links on screen instead of emailing them.
# Leave unset in production.
PORTAL_DEMO_SEED=

# Spotify integration is offline — tracks are sourced from data/playlist-tracks.json.
# To update the reference song list, edit that file directly. No Spotify env vars needed.
